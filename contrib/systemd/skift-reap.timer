# Runs the lease reaper once a minute. A lease outlives its TTL by at most
# this interval plus the timer's accuracy before its node is ready again;
# a claim in the meantime expires it itself rather than waiting.
#
#   systemctl enable --now skift-reap.timer

[Unit]
Description=skift: expire stale leases every minute
Documentation=https://github.com/steading-ai/skift

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s
Unit=skift-reap.service

[Install]
WantedBy=timers.target
