# The skift service, as a system unit: it runs as the skift system user
# and listens on /run/skift/skift.sock. Callers on the host are identified by
# the uid on their end of that socket, so a caller must reach it: the
# directory is group skift and setgid (see packaging/tmpfiles.d/), the
# socket is born in that group, and its 0660 mode admits the group. Add a
# caller to the skift group and start it a new session.
#
# The rpm installs this unit but does not enable or start it:
#
#   systemctl enable --now skift.service skift-reap.timer
#
# DATABASE_URL and any other settings come from /etc/skift/env, one
# KEY=value per line; the package ships a template there. The tailnet is
# turned on from the same file: SKIFT_TAILNET_HOSTNAME, SKIFT_TAILNET_TAGS
# and TS_AUTHKEY, with the node's state kept under StateDirectory=.
#
# Readiness is sd_notify: the unit is active only once the service has
# bound its socket, the database has answered, and the schema is current
# (the service migrates at start), so anything ordered After= it can rely
# on all three.

[Unit]
Description=skift: agent-first project management on a DAG
Documentation=https://github.com/steading-ai/skift
After=network.target

[Service]
Type=notify
NotifyAccess=main
User=skift
Group=skift
EnvironmentFile=-%E/skift/env
# /var/lib/skift: state that outlives a restart, which today is the tailnet
# node's keys. A node that lost them would enrol again as a new node.
StateDirectory=skift
StateDirectoryMode=0700
# The socket directory is systemd-tmpfiles' to create, not this unit's: a
# RuntimeDirectory= would be removed with the unit and recreated in its own
# mode, and the setgid bit on it is what admits callers.
ExecStart=/usr/bin/skift serve --socket %t/skift/skift.sock
# skift serve drains in-flight requests for up to its --shutdown-timeout
# (30s by default) before exiting; give it that and a margin.
TimeoutStopSec=45
KillSignal=SIGTERM
Restart=on-failure
RestartSec=2
# Log records go to stderr with sd-daemon priority prefixes, which the
# journal turns into the PRIORITY field.
StandardOutput=journal
StandardError=journal
SyslogLevelPrefix=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
