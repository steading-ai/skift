# Settings for contrib/docker-compose.yaml. Copy to skift.env, fill in the
# blanks, and pass it to compose:
#
#   docker compose --env-file skift.env up -d
#
# Nothing here is a usable value. Keep the filled-in copy out of version
# control: it holds the database password and the tailnet auth key.

# The skift image to run. The compose file attached to a release names its
# own image and does not read this; the one in the repository does.
# ghcr.io/steading-ai/skift:<version> is a release, and adding
# @sha256:<digest> pins it.
SKIFT_IMAGE=

# The role PostgreSQL is initialised with, and skift connects as.
POSTGRES_USER=skift

# That role's password. It is placed in a connection URL as written, so
# keep to letters and digits: `openssl rand -hex 32` makes one.
POSTGRES_PASSWORD=

# The database skift keeps its graph in.
POSTGRES_DB=skift

# Network transports. Each is off until its variables are set.

# Tailscale. The name skift joins the tailnet under; empty leaves the
# transport off.
SKIFT_TAILNET_HOSTNAME=

# The auth key that enrols the node on its first start. Not needed again
# once the node's state is in the state volume.
TS_AUTHKEY=

# ACL tags the node advertises, comma separated: tag:skift,tag:prod
SKIFT_TAILNET_TAGS=
