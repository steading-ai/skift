# Files `make cover` leaves out of the hand-written coverage figure. One
# extended regular expression per line, matched against the import path of
# each file in the profile; a comment above each says why.

# Generated from proto/ by buf. Its specs are the contract suite, which checks
# the wire, not every accessor.
^github\.com/steading-ai/skift/gen/

# Generated from internal/store/queries/ by sqlc. The domain specs exercise the
# queries the domain calls; the rest are unused output.
\.gen\.go:

# Helpers for specs, not shipped code.
^github\.com/steading-ai/skift/internal/testsupport/

# The tailnet transport listens through tsnet, which needs a tailnet and a
# node key to do anything; the specs cover the interceptor it feeds through
# a loopback stand-in instead.
^github\.com/steading-ai/skift/internal/server/transport/tsnet\.go:
