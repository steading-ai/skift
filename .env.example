# Local development settings. Copy to .env (gitignored); `make db-up` does
# this for you on first run. Values here are for the throwaway development
# database only and must never be reused anywhere else.

# Consumed by compose.yaml.
POSTGRES_USER=skift
POSTGRES_PASSWORD=skift
POSTGRES_DB=skift
# Host port the database is published on (127.0.0.1 only).
DB_PORT=5432

# What skift and goose connect with. Keep in step with the values above.
DATABASE_URL=postgres://skift:skift@127.0.0.1:5432/skift?sslmode=disable
